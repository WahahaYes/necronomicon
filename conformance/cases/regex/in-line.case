# in: line matches the raw line, comments included
spec: Checks
args: --format terse
exit: 1
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    explain: Long form.
    check: { regex: '(?P<word>\bbad\b)', in: line }
-- src/a.gd --
# bad
-- @stdout --
src/a.gd:1:3: t/clean src doesn't say bad
