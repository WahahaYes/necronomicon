# named groups fill placeholders; the summary uses the value
spec: Checks; Messages
args: --format terse
exit: 1
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summary: "{{name}} is called with {{arg}}"
    why: Because.
    help: fix it
    check: { regex: '(?P<name>\w+)\((?P<arg>\d+)\)' }
    explain: Long form.
-- src/a.gd --
func f(): go(1); stop(22)
-- @stdout --
src/a.gd:1:11: t/clean go is called with 1
src/a.gd:1:18: t/clean stop is called with 22
