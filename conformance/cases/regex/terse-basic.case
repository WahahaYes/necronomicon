# terse: one line per hit, sorted by code, file, line and column; any error hit exits 1
spec: Messages; CLI
args: --format terse
exit: 1
-- src/b/c.gd --
var x = bad + bad
-- src/a.ts --
const a = "bad";
-- @stdout --
src/a.ts:1:12: t/clean src doesn't say bad
src/b/c.gd:1:9: t/clean src doesn't say bad
src/b/c.gd:1:15: t/clean src doesn't say bad
