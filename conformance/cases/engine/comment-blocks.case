# runs of one marker are blocks; the first block after the preamble is the header; inline comments don't count
spec: Built-in checks
args: --format terse
exit: 1
-- necro/t.yaml --
guide: The t rules.
rules:
  length:
    summary: "a comment block is {{lines}} lines, over {{limit}}"
    why: Because.
    help: "cut it to {{limit}}"
    check: engine.comment-blocks
    params: { header: 3, block: 2 }
    explain: Long form.
-- src/a.gd --
@tool
class_name A
## one
## two
## three
## four
extends Node
# x
# y
# z
var a = 1  # inline
## p
## q
## r
func f():
	# one
	# two
	pass
-- @stdout --
src/a.gd:3:1: t/length a comment block is 4 lines, over 3
src/a.gd:8:1: t/length a comment block is 3 lines, over 2
src/a.gd:12:1: t/length a comment block is 3 lines, over 2
