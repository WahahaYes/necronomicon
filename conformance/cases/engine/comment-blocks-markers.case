# markers limits which comments count
spec: Built-in checks
args: --format terse
exit: 1
-- necro/t.yaml --
guide: The t rules.
rules:
  length:
    summary: "a comment block is {{lines}} lines, over {{limit}}"
    why: Because.
    help: "cut it to {{limit}}"
    check: engine.comment-blocks
    params: { header: 3, block: 2, markers: ["##"] }
    explain: Long form.
-- src/a.gd --
extends Node
# a
# b
# c
# d
func f():
	## x
	## y
	## z
	pass
-- @stdout --
src/a.gd:7:2: t/length a comment block is 3 lines, over 2
