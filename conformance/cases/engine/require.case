# engine.require: one line-0 hit per missing pattern, matched over code (comments blanked)
spec: Built-in checks
args: --format terse
exit: 1
-- necro/t.yaml --
guide: The t rules.
files: ["src/net/**"]
rules:
  wire:
    summary: "net file never mentions {{pattern}}"
    why: Because.
    help: "route it through {{pattern}}"
    check: engine.require
    params: { patterns: [MatchProtocol] }
    where:
      - files: ["src/net/replica.gd"]
        params: { patterns: [MatchProtocol, '"rollover"', '"steal_resolved"'] }
    explain: Long form.
-- src/net/ok.gd --
const V: int = MatchProtocol.PROTO_V
-- src/net/bad.gd --
# MatchProtocol only in a comment
var x: int = 1
-- src/net/replica.gd --
var m = MatchProtocol.decode(b)
var r = p.get("rollover", 0)
-- @stdout --
src/net/bad.gd:0:1: t/wire net file never mentions MatchProtocol
src/net/replica.gd:0:1: t/wire net file never mentions "steal_resolved"
