# --explain: message, why, fix, details, examples, command, trial
spec: CLI
args: --explain no-bad
-- docs/no-bad.md --
Words carry tone into reviews and logs.
-- necro.yaml --
version: 0
rules:
  no-bad:
    command: git grep -n --column -o -E '\bbad\b' -- 'src/*'
    message: Bad word
    why: Because.
    fix: Say good.
    details: { file: docs/no-bad.md }
    examples:
      bad: const a = "bad";
      good:
        - const a = "good";
        - |
          // a comment that says bad is still a hit; allow it
          const b = "fine";
    trial: true
-- @stdout --
no-bad (trial): Bad word

Why: Because.

Fix: Say good.

Words carry tone into reviews and logs.

Bad:
    const a = "bad";

Good:
    const a = "good";

    // a comment that says bad is still a hit; allow it
    const b = "fine";

Command: git grep -n --column -o -E '\bbad\b' -- 'src/*'
