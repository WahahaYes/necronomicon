# a count above the baseline shows every hit of that group and says by how much
spec: The baseline
args: --format terse
exit: 1
-- necro.baseline --
# necro.baseline: hits accepted when adopted; rule, path, label, count. Rewrite with: necro baseline
banned-word	src/a.ts	donkey	1
-- src/a.ts --
donkey
donkey
-- src/b.ts --
donkey
-- @stdout --
src/a.ts:1:1: banned-word Banned word
src/a.ts:2:1: banned-word Banned word
src/b.ts:1:1: banned-word Banned word
