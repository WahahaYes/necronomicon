# every config error is reported, sorted by file and line
spec: Scope and parameters (loading validates everything)
-- necro.yaml --
version: 0
files: ["src/**"]
groups: [necro, t]
colour: red
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: { regex: '(?P<word>\bbad\b)' }
    explain: Long form.
    severity: warn
-- @config-error --
necro.yaml:4:1: colour
necro/t.yaml:9:15: rules.clean.severity
