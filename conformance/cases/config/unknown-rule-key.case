# an unknown key and the missing key it replaced are both reported, in order
spec: Scope and parameters (loading validates everything)
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summry: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: { regex: '(?P<word>\bbad\b)' }
    explain: Long form.
-- @config-error --
necro/t.yaml:3:3: rules.clean.summary
necro/t.yaml:4:5: rules.clean.summry
