# a comment-reading engine check scoped to an extension the table doesn't know
spec: Languages
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summary: "a comment block is {{lines}} lines"
    why: Because.
    help: cut it
    check: engine.comment-blocks
    explain: Long form.
-- src/notes.txt --
hello
