# a where entry is scoped by files
spec: Scope and parameters
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: { regex: '(?P<word>\bbad\b)' }
    explain: Long form.
    where:
      - severity: experimental
-- @config-error --
necro/t.yaml:10:9: rules.clean.where[0].files
