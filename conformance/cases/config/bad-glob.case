# globs are validated at load
spec: Scope and parameters
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: { regex: '(?P<word>\bbad\b)' }
    explain: Long form.
    files: ["src/{a"]
-- @config-error --
necro/t.yaml:9:13: rules.clean.files[0]
