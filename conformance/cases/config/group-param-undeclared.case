# a group param must be declared by one of its rules' checks
spec: Groups and rules
-- necro/t.yaml --
guide: The t rules.
params: { limit: 3 }
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: { regex: '(?P<word>\bbad\b)' }
    explain: Long form.
-- @config-error --
necro/t.yaml:2:11: params.limit
