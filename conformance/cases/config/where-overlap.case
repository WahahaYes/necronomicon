# two where entries that match one file and set one key, found from the run's files
spec: Scope and parameters
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summary: "src lacks {{pattern}}"
    why: Because.
    help: add it
    check: engine.require
    params: { patterns: [x] }
    explain: Long form.
    where:
      - files: ["src/net/**"]
        params: { patterns: [Proto] }
      - files: ["**/*.gd"]
        params: { patterns: [Wire] }
-- src/net/a.gd --
Proto Wire x
-- @config-error --
necro/t.yaml:13:9: rules.clean.where[1].params.patterns
