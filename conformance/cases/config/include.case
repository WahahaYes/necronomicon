# include globs pull in more files holding rules
spec: A rule
args: --format terse
exit: 1
-- necro/style.yaml --
rules:
  no-worse:
    command: git grep -n --column -o -E '\bworse\b' -- 'src/*'
    message: Worse word
    why: Because.
    fix: Say better.
-- necro.yaml --
version: 0
include: [necro/*.yaml]
rules:
  no-bad:
    command: git grep -n --column -o -E '\bbad\b' -- 'src/*'
    message: Bad word
    why: Because.
    fix: Say good.
-- src/a.ts --
bad worse
-- @stdout --
src/a.ts:1:1: no-bad Bad word
src/a.ts:1:5: no-worse Worse word
