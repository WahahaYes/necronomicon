# examples show at least one bad and one good
spec: A rule
-- necro.yaml --
version: 0
rules:
  banned-word:
    command: git grep -n -e donkey -- 'src/*'
    message: Banned word
    why: Because.
    fix: Say good.
    examples:
      bad: const a = "donkey";
-- @config-error --
necro.yaml:8:5: rules.banned-word.examples.good
