# a regex that doesn't compile is a config error at load
spec: Checks
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: { regex: '(?P<word>bad' }
    explain: Long form.
-- @config-error --
necro/t.yaml:7:21: rules.clean.check.regex
