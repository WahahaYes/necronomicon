# a text field may point at a file, printed as is
spec: A rule
exit: 1
-- docs/why.txt --
Bad words spread:
people copy what they read.
-- necro.yaml --
version: 0
rules:
  no-bad:
    command: git grep -n --column -o -E '\bbad\b' -- 'src/*'
    message: Bad word
    why: { file: docs/why.txt }
    fix: Say good.
-- src/a.ts --
bad
-- @stdout --
error[no-bad]: Bad word
 --> src/a.ts:1:1
  |
1 | bad
  | ^^^
  |
  = why: Bad words spread:
         people copy what they read.
  = fix: Say good.
  = more: necro --explain no-bad

necro: 1 error (no-bad ×1)
