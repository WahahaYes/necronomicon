# a project check sees every file in scope, even when files are given
spec: Check protocol; CLI
args: src/a.ts
-- necro/t.yaml --
guide: The t rules.
command: python3 necro/t.py
rules:
  whole:
    summary: whole tree
    why: Because.
    help: fix it
    check: t.all
    explain: Long form.
-- src/a.ts --
a
-- src/b.ts --
b
-- src/c/d.ts --
d
-- @stdout --
necro: warning: t: job 1: saw 3 files
