# the copyable Python helper (helpers/necro_check.py): file and project checks, params, warnings
spec: Check protocol
args: --format terse
exit: 1
-- necro/t.yaml --
guide: The t rules.
command: python3 necro/lines.py
rules:
  long:
    summary: "a line is {{width}} wide, over {{limit}}"
    why: Because.
    help: wrap it
    check: t.long_lines
    params: { limit: 5 }
    explain: Long form.
  count:
    summary: "{{n}} files"
    why: Because.
    help: fewer
    check: t.count
    explain: Long form.
-- necro/lines.py --
from necro_check import check, run


@check(params={"limit": ("number",)}, values=["width"])
def long_lines(path, text, params):
    for n, line in enumerate(text.split("\n"), 1):
        if len(line) > params["limit"]:
            yield {"line": n, "column": params["limit"] + 1, "values": {"width": len(line)}}


@check(scope="project", values=["n"])
def count(texts, params):
    yield {"warning": f"counted {len(texts)}"}
    yield {"file": sorted(texts)[0], "line": 0, "values": {"n": len(texts)}}


run()
-- src/a.ts --
short
much too long
-- src/b.ts --
ok
-- @stdout --
src/a.ts:0:1: t/count 2 files
src/a.ts:2:6: t/long a line is 13 wide, over 5
