# the whole process has the group's timeout; the engine kills it
spec: Check protocol
env: T_MODE=sleep
exit: 2
-- necro/t.yaml --
guide: The t rules.
command: python3 necro/t.py
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: t.ban
    explain: Long form.
timeout: 1
-- src/a.ts --
bad
-- @stderr --
necro: check error: t (python3 necro/t.py): timed out
