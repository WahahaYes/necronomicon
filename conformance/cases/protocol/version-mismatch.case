# a protocol mismatch names both versions
spec: Check protocol
env: T_MODE=proto2
exit: 2
-- necro/t.yaml --
guide: The t rules.
command: python3 necro/t.py
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: t.ban
    explain: Long form.
-- src/a.ts --
bad
-- @stderr --
necro: check error: t (python3 necro/t.py): it speaks protocol 2; necro speaks 1
