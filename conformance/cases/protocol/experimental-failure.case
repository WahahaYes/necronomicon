# a failing check used only by experimental rules is reported but doesn't fail the run
spec: Check protocol (check failure)
env: T_MODE=exit1
-- necro/t.yaml --
guide: The t rules.
command: python3 necro/t.py
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: t.ban
    explain: Long form.
    severity: experimental
-- src/a.ts --
bad
-- @stderr --
necro: check error: t (python3 necro/t.py): exited with status 1
  | t.py: something broke
