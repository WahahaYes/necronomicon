# identical (check, params, files) jobs from different rules are sent once
spec: Check protocol
-- necro/t.yaml --
guide: The t rules.
command: [python3, necro/t.py]
rules:
  one:
    summary: one
    why: Because.
    help: fix it
    check: t.calls
    explain: Long form.
  two:
    summary: two
    why: Because.
    help: fix it
    check: t.calls
    explain: Long form.
  three:
    summary: three
    why: Because.
    help: fix it
    check: t.calls
    params: { tag: other }
    explain: Long form.
-- src/a.ts --
a
-- @stdout --
necro: warning: t: called with {"tag": ""}
necro: warning: t: called with {"tag": "other"}
