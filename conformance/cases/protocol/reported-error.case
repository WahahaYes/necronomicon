# an error the script reports means the check couldn't run
spec: Check protocol
env: T_MODE=error
exit: 2
-- necro/t.yaml --
guide: The t rules.
command: python3 necro/t.py
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: t.ban
    explain: Long form.
-- src/a.ts --
bad
-- @stderr --
necro: check error: t (python3 necro/t.py): it reported an error: job 1: can't parse src/a.ts
