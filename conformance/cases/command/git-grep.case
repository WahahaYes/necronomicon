# a git grep rule: every match a hit; terse lists them sorted by rule, path, line, column
spec: Commands; Messages
args: --format terse
exit: 1
-- src/b/c.gd --
var x = bad + bad
-- src/a.ts --
const a = "bad";
-- other/d.ts --
bad
-- @stdout --
src/a.ts:1:12: no-bad Bad word
src/b/c.gd:1:9: no-bad Bad word
src/b/c.gd:1:15: no-bad Bad word
