# a where entry overrides wording and severity for the files it matches
spec: Scope and parameters
args: --format terse
exit: 1
-- necro/t.yaml --
guide: The t rules.
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    explain: Long form.
    check: { regex: '(?P<word>\bbad\b)' }
    where:
      - files: ["src/old/**"]
        severity: experimental
        summary: "old code says {{word}}"
-- src/a.ts --
bad
-- src/old/b.ts --
bad
-- @stdout --
src/a.ts:1:1: t/clean src doesn't say bad
src/old/b.ts:1:1: t/clean old code says bad
