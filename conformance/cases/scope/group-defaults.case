# a group's files and severity are defaults for its rules; the rule's own win
spec: Groups and rules; Scope and parameters
args: --format terse
-- necro/t.yaml --
guide: The t rules.
files: ["src/a/**"]
severity: experimental
rules:
  clean:
    summary: "src doesn't say {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: { regex: '(?P<word>\bbad\b)' }
    explain: Long form.
  other:
    summary: "no {{word}}"
    why: Because.
    help: "drop {{word}}"
    check: { regex: '(?P<word>\bworse\b)' }
    files: ["src/b/**"]
    explain: Long form.
-- src/a/x.ts --
bad worse
-- src/b/y.ts --
bad worse
-- @stdout --
src/a/x.ts:1:1: t/clean src doesn't say bad
src/b/y.ts:1:5: t/other no worse
