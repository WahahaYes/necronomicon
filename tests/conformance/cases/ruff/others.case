# --others: ruff's defaults and the repo's selection, minus the fixed set and --except; a noqa for a set code isn't unused; a file ruff can't parse is a hit here
behavior: ruff-others-reports-other-diagnostics
args: ruff check --others --except=I
-- pyproject.toml --
[tool.ruff.lint]
extend-select = ["T201"]
-- src/a.py --
import sys
import os


def f(d):
    try:
        return d["k"]
    except KeyError:
        raise ValueError("no k")  # noqa: B904


print(f == None)
-- src/bad.py --
def f(:
