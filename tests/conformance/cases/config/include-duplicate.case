# rule names are unique across necro.yaml and its includes
spec: A rule
-- necro/more.yaml --
rules:
  banned-word:
    command: git grep -n -e donkey -- 'src/*'
    message: Again
    why: Because.
    fix: Say good.
-- necro.yaml --
version: 0
include: [necro/*.yaml]
rules:
  banned-word:
    command: git grep -n -e donkey -- 'src/*'
    message: Banned word
    why: Because.
    fix: Say good.
-- @config-error --
necro/more.yaml:2:3: rules.banned-word
