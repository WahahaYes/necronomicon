# with neither --template nor line words there is no header to keep
spec: Finders
args: header -- 'src/*'
exit: 2
-- @stderr --
necro: header: give the header as --template <file> or as lines: necro header [--files-from <file>] [--template <file>] [--marker <ext>=<marker>]… [--similar <percent>] [--write [--only-at <file>]] [<line>…] [-- <pathspec>…]
