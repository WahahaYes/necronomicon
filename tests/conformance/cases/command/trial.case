# a trial rule's hits are shown but never fail
spec: A rule (trial)
exit: 0
-- necro.yaml --
version: 0
rules:
  banned-word:
    command: git grep -n --column -o -E '\bdonkey\b' -- 'src/*'
    message: Banned word
    why: Because.
    fix: Say good.
    trial: true
-- src/a.ts --
donkey
-- @stdout --
trial[banned-word]: Banned word
 --> src/a.ts:1:1
  |
1 | donkey
  | ^^^^^^
  |
  = why: Because.
  = fix: Say good.
  = more: necro --explain banned-word

necro: 1 trial hit, not failing (banned-word ×1)
