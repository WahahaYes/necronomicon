# a git grep rule: every match a hit; terse lists them sorted by rule, path, line, column
spec: Commands; Messages
args: --format terse
exit: 1
-- src/b/c.gd --
var x = donkey
var y = donkey
-- src/a.ts --
const a = "donkey";
-- other/d.ts --
donkey
-- @stdout --
src/a.ts:1:12: banned-word Banned word
src/b/c.gd:1:9: banned-word Banned word
src/b/c.gd:2:9: banned-word Banned word
