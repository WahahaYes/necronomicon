# NECRO_ROOT_DIR, if set, is the root
spec: Commands (where it runs)
args: --format terse
env: NECRO_ROOT_DIR=<root>/inner
exit: 1
-- inner/necro.yaml --
version: 0
rules:
  inner-word:
    command: git grep -n --column -o -E '\bdonkey\b' -- 'src/*'
    message: Banned word inside
    why: Because.
    fix: Say good.
-- inner/src/a.ts --
donkey
-- src/a.ts --
donkey
-- @stdout --
src/a.ts:1:1: inner-word Banned word inside
