args: gdtoolkit lint
-- src/a.gd --
extends Node


func pick(x: int) -> int:
	if x == 1:
		return 1
	if x == 2:
		return 2
	if x == 3:
		return 3
	if x == 4:
		return 4
	if x == 5:
		return 5
	if x == 6:
		return 6
	return 0


func BadName() -> void:
	pass
