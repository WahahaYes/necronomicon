# every non-empty match on a line is a hit, columns in code points, sorted by path, line, column
spec: Finders
args: grep '\bdonkey\b' -- 'src/*'
-- src/b.ts --
é donkey, donkey
-- src/a.ts --
donkey
-- other/c.ts --
donkey
-- @stdout --
src/a.ts:1:1-6: donkey
src/b.ts:1:3-8: donkey
src/b.ts:1:11-16: donkey
