# gdscan needs a check it knows
behavior: gdscan-rejects-an-unknown-check
args: gdscan nope
exit: 2
-- @stderr --
necro: gdscan: unknown check nope: necro gdscan [--files-from <file>] [--header <n>] [--item <n>] [--write [--only-at <file>]] (spacing|inline-lambda|doc-length|export-doc|uid|physics-context|resource-behavior|res-write|class-by-name|data-comment) [-- <pathspec>…]
