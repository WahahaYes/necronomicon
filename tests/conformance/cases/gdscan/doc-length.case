# doc-length: the header run after the preamble gets --header lines, any other own-line ## run --item
spec: Finders
args: gdscan --header 2 --item 1 doc-length
-- src/a.gd --
@tool
extends Node
## One.
## Two.
## Three.

func f() -> void:
	## One.
	## Two.
	pass  ## trailing, not own-line
-- @stdout --
src/a.gd:3:1: 3 lines, over 2
src/a.gd:8:2: 2 lines, over 1
