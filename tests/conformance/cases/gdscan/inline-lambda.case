# inline-lambda: each func( lambda inside an open bracket, opened on that line or an earlier one; a lambda outside brackets is fine
spec: Finders
args: gdscan inline-lambda
-- src/a.gd --
func f() -> void:
	var hooks: Array = [
		func() -> void: pass,
	]
	var ok: Array = [1].filter(func(x): return x > 0)
	var both: Array = [func(): pass, func(): pass]
	var named: Callable = func(x): return x
	# items.map(func(x): x) in a comment
	var text: String = "map(func(x): x)"
