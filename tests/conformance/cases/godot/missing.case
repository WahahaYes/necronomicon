# without godot on PATH, the finder says what to install or disable
behavior: missing-godot-says-what-to-do
args: godot compile
env: PATH=/usr/bin:/bin
exit: 2
-- project.godot --
config_version=5
-- src/a.gd --
extends Node
-- @stderr --
necro: godot: godot isn't on PATH; install the Godot version project.godot names, or disable gdscript/compile and gdscript/warnings
