# warnings: each warning Godot gives while loading the project's scripts, at its line; engine warnings that name no script are ignored
behavior: godot-warnings-reports-warnings
args: godot warnings
exec: bin/godot
env: PATH=<root>/bin:/usr/bin:/bin
-- bin/godot --
#!/bin/sh
# Fake godot: logs each call to calls.log; --import marks the project
# imported; a check prints the project's out.txt (stale.txt until imported).
project=.
import=no
last=
prev=
for a in "$@"; do
  [ "$prev" = "--path" ] && project=$a
  [ "$a" = "--import" ] && import=yes
  prev=$a
  last=$a
done
if [ "$import" = yes ]; then
  echo "import $project" >> calls.log
  mkdir -p "$project/.godot" && touch "$project/.godot/imported" "$project/.godot/global_script_class_cache.cfg"
  exit 0
fi
echo "check $project" >> calls.log
sed 's/^/  /' "$last" >> calls.log
if [ -f "$project/stale.txt" ] && [ ! -f "$project/.godot/imported" ]; then
  cat "$project/stale.txt" >&2
else
  cat "$project/out.txt" >&2
fi
-- game/project.godot --
config_version=5
-- game/.godot/global_script_class_cache.cfg --
list=[]
-- game/.godot/imported --
yes
-- game/src/bad.gd --
extends Node
-- game/src/uses_bad.gd --
extends Node
-- game/src/warns.gd --
extends Node
-- game/src/ok.gd --
extends Node
-- game/.hidden/skip.gd --
extends Node
-- game/raw/.gdignore --
Godot skips this folder.
-- game/raw/skip.gd --
extends Node
-- game/out.txt --
Godot Engine v4.7.2.stable.official - https://godotengine.org

