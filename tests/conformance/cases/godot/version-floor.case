# a Godot older than 4.5, which prints no GDScript warnings, is a check error even when the project names it
behavior: godot-runs-the-version-the-project-names
args: godot compile
exec: bin/godot
env: PATH=<root>/bin:/usr/bin:/bin FAKE_GODOT_VERSION=4.3.stable.official.x
exit: 2
-- bin/godot --
#!/bin/sh
# Fake godot: logs each call to calls.log; --import marks the project
# imported; a check prints the project's out.txt (stale.txt until imported);
# --version prints $FAKE_GODOT_VERSION, 4.7.2 by default.
if [ "$1" = "--version" ]; then
  echo "${FAKE_GODOT_VERSION:-4.7.2.stable.official.ed1daf0bf}"
  exit 0
fi
project=.
import=no
last=
prev=
for a in "$@"; do
  [ "$prev" = "--path" ] && project=$a
  [ "$a" = "--import" ] && import=yes
  prev=$a
  last=$a
done
if [ "$import" = yes ]; then
  echo "import $project" >> calls.log
  mkdir -p "$project/.godot" && touch "$project/.godot/imported" "$project/.godot/global_script_class_cache.cfg"
  exit 0
fi
echo "check $project" >> calls.log
sed 's/^/  /' "$last" >> calls.log
if [ -f "$project/stale.txt" ] && [ ! -f "$project/.godot/imported" ]; then
  cat "$project/stale.txt" >&2
else
  cat "$project/out.txt" >&2
fi
-- project.godot --
config_version=5

[application]

config/features=PackedStringArray("4.3", "Forward Plus")
-- .godot/global_script_class_cache.cfg --
list=[]
-- src/a.gd --
extends Node
-- out.txt --
Godot Engine
-- @stderr --
necro: godot: godot is Godot 4.3; necro needs 4.5 or later, which prints GDScript warnings
