# necro:rust adds the pack's rules, named <pack>/<rule>; with no Cargo workspace its cargo rules find nothing
spec: Packs
args: --format terse
exit: 1
-- necro.yaml --
version: 0
include: [necro:rust-style]
-- src/a.rs --
//! A.
struct ConfigManager {}
-- @stdout --
src/a.rs:2:1: rust-style/weasel-type-names a type named for a role, not a thing
