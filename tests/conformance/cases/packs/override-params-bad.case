# an overridden parameter must be one the rule declares, with a value of the default's kind
spec: Packs; Parameters
-- necro.yaml --
version: 0
include: [necro:rust]
override:
  rust/weasel-type-names: { params: { role-words: [a, b], nope: x } }
  rust/no-unwrap: { params: { x: 1 } }
