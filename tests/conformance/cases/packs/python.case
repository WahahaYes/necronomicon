# necro:python runs ruff's defaults and formatter, ty's type checks, and its own selection: raise-from, is-compare, star-import, blanket-ignore, logging-fstring, and annotations outside tests
behavior: python-pack
args: --format terse
exit: 1
-- necro.yaml --
version: 0
include: [necro:python]
-- src/a.py --
import logging
from os.path import *

log = logging.getLogger(__name__)


def load(table, key):
    try:
        return table[key]
    except KeyError:
        raise ValueError(f"no {key}")


def report(value) -> None:
    if value == None:
        log.info(f"empty {value}")
    x = join("a", "b")  # type: ignore
    for i in range(3):
        print(lambda: i)
-- src/fmt.py --
x = {  "a":1 }
-- src/t.py --
count: int = "three"
-- tests/test_a.py --
def test_load(tmp_path):
    assert tmp_path
