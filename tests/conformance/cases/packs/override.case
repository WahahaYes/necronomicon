# override replaces a pack rule's exclude: hits in the excluded files are dropped in a full run
spec: Packs
args: --format terse
exit: 1
-- necro.yaml --
version: 0
include: [necro:rust-style]
override:
  rust-style/weasel-type-names: { exclude: '^gen/' }
-- src/a.rs --
//! A.
struct ConfigManager {}
-- gen/b.rs --
//! A.
struct ConfigManager {}
-- @stdout --
src/a.rs:2:1: rust-style/weasel-type-names a type named for a role, not a thing
