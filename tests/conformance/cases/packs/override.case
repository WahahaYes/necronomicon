# override replaces a pack rule's exclude: hits in the excluded files are dropped in a full run
spec: Packs
args: --format terse
exit: 1
-- necro.yaml --
version: 0
include: [necro:rust]
override:
  rust/weasel-type-names: { exclude: '^gen/' }
-- src/a.rs --
struct ConfigManager {}
-- gen/b.rs --
struct ConfigManager {}
-- @stdout --
src/a.rs:1:1: rust/weasel-type-names a type named for a role, not a thing
