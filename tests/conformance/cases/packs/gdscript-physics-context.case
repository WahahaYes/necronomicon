# gdscript/physics-context flags a physics-step call inside _process; the same call in _physics_process stays silent
spec: Packs
args: --format terse --rule gdscript/physics-context
exit: 1
-- necro.yaml --
version: 0
include: [necro:gdscript]
-- src/a.gd --
extends CharacterBody2D


func _process(delta: float) -> void:
	velocity = move_and_slide()


func _physics_process(delta: float) -> void:
	move_and_slide()
-- @stdout --
src/a.gd:5:13: gdscript/physics-context a physics-step call inside _process
