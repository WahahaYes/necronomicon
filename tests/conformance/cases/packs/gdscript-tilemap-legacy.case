# gdscript/tilemap-legacy flags extends TileMap and TileMap.new(); TileMapLayer stays silent
spec: Packs
args: --format terse --rule gdscript/tilemap-legacy
exit: 1
-- necro.yaml --
version: 0
include: [necro:gdscript]
-- src/a.gd --
extends TileMap


func make() -> TileMapLayer:
	var map: TileMap = TileMap.new()
	return TileMapLayer.new()
