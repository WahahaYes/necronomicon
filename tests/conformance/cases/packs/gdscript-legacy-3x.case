# gdscript/legacy-3x-api flags deprecated Godot 3 spellings: string connect, yield, instance(), emit_signal
spec: Packs
args: --format terse --rule gdscript/legacy-3x-api
exit: 1
-- necro.yaml --
version: 0
include: [necro:gdscript]
-- src/a.gd --
extends Node


func _ready() -> void:
	button.connect("pressed", Callable(self, "_on_pressed"))
	var state: int = yield(loader, "finished")
	var copy: Node = packed.instance()
	emit_signal("player_died")
