# given files, stale baseline entries are counted only in those files
spec: Narrowed runs
args: --format terse src/a.ts
-- src/a.ts --
const ok = 1;
-- src/b.ts --
const ok = 2;
-- necro.baseline.yaml --
version: 1
entries:
  - rule: "banned-word"
    path: "src/a.ts"
    fingerprint: "const a = \"donkey\";"
    line: 1
  - rule: "banned-word"
    path: "src/b.ts"
    fingerprint: "const b = \"donkey\";"
    line: 1
-- @stderr --
necro: warning: 1 baseline entry no longer matches; refresh with necro --write-baseline
